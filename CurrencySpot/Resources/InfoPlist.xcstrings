    "NSCameraUsageDescription" : {
      "comment" : "Camera permission prompt shown when the app first asks to use the camera for price scanning.",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CurrencySpot verwendet die Kamera, um Preise zu erkennen und in deiner Währung anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CurrencySpot uses the camera to detect prices and show them converted to your currency."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CurrencySpot usa la cámara para detectar precios y mostrarlos convertidos a tu divisa."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CurrencySpot usa la cámara para detectar precios y mostrarlos convertidos a tu divisa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CurrencySpot utilise l’appareil photo pour détecter les prix et les afficher convertis dans votre devise."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CurrencySpotはカメラで価格を読み取り、選択した通貨に換算して表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "카메라로 가격표를 비추면 선택한 통화로 환산해 보여드려요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "汇见使用相机识别价格，并换算成你选择的币种。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "匯見使用相機辨識價格，並換算成你選擇的幣別。"
