          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los tipos de cambio no se pueden guardar en este dispositivo. La app funciona con normalidad, pero los datos no se conservarán al cerrarla."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
