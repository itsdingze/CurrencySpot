    "history.row.accessibilityLabel.down" : {
      "comment" : "VoiceOver label of a History row whose rate fell this week. code, target: the row's ISO currency code. name: localized currency name. base: base currency code. rate: formatted rate. change: formatted weekly change.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(code)@, %2$(name)@, 1 %3$(base)@ entspricht %4$(rate)@ %5$(target)@, in der letzten Woche um %6$(change)@ gefallen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(code)@, %2$(name)@, 1 %3$(base)@ equals %4$(rate)@ %5$(target)@, down %6$(change)@ over the past week"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(code)@, %2$(name)@, 1 %3$(base)@ equivale a %4$(rate)@ %5$(target)@, baja %6$(change)@ en la última semana"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(code)@, %2$(name)@, 1 %3$(base)@ equivale a %4$(rate)@ %5$(target)@, baja %6$(change)@ en la última semana"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(code)@, %2$(name)@. 1 %3$(base)@ égale %4$(rate)@ %5$(target)@. Baisse de %6$(change)@ sur les sept derniers jours."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(code)@、%2$(name)@。1 %3$(base)@は%4$(rate)@ %5$(target)@です。この1週間で%6$(change)@下落しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(code)@, %2$(name)@. 기준 통화: 1 %3$(base)@. 환산 금액: %4$(rate)@ %5$(target)@. 최근 일주일간 %6$(change)@ 하락했어요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(code)@，%2$(name)@，1 %3$(base)@ 等于 %4$(rate)@ %5$(target)@，近一周下跌 %6$(change)@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$(code)@，%2$(name)@，1 %3$(base)@ 等於 %4$(rate)@ %5$(target)@，近一週下跌 %6$(change)@"
          }
        }
      }
    },
