    "camera.permission.message" : {
      "comment" : "Camera screen message before the camera permission prompt.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Richte deine Kamera auf ein Preisschild oder eine Speisekarte und sieh jeden Preis in deiner Währung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Point your camera at a price tag or menu and see every price in your currency."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta la cámara a una etiqueta de precio o a una carta y verás cada precio en tu divisa."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta la cámara a una etiqueta de precio o a un menú y verás cada precio en tu divisa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pointez votre appareil photo vers une étiquette de prix ou un menu pour voir chaque prix dans votre devise."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "値札やメニューにカメラを向けると、選んだ通貨で価格を確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가격표나 메뉴판을 비춰 보세요. 가격을 선택한 통화로 환산해 보여드려요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对准价签或菜单，即可将价格换算成你选择的币种。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
