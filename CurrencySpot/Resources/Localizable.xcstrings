    "calculator.announcement.failedRetry" : {
      "comment" : "VoiceOver announcement on the converter screen when rates fail to load while online; the screen shows a Try Again button.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechselkurse konnten nicht geladen werden. Versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't load exchange rates. Try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido cargar los tipos de cambio. Inténtalo de nuevo."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron cargar las tasas de cambio. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger les taux de change. Réessayez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為替レートを読み込めませんでした。やり直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "환율을 불러오지 못했어요. 다시 시도해 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法加载汇率，请重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法載入匯率，請再試一次。"
          }
        }
      }
    },
    "calculator.announcement.failedSampleRates" : {
      "comment" : "VoiceOver announcement on the converter screen when rates fail to load while offline; the screen shows a Use Sample Rates button.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechselkurse konnten nicht geladen werden. Du kannst „Beispielkurse verwenden“ wählen. Das sind keine echten Wechselkurse."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couldn't load exchange rates. You can choose Use Sample Rates. Sample rates aren't real exchange rates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se han podido cargar los tipos de cambio. Puedes usar tipos de ejemplo, que no son reales."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudieron cargar las tasas de cambio. Puedes usar tasas de ejemplo, que no son reales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de charger les taux de change. Vous pouvez utiliser des taux d’exemple. Ces taux sont fictifs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為替レートを読み込めませんでした。“サンプルレートを使用”を選べます。実際の為替レートではありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "환율을 불러오지 못했어요. 예시 환율을 사용할 수 있어요. 예시 환율은 실제 환율이 아니에요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法加载汇率，可选择“使用示例汇率”。示例汇率为虚构数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法載入匯率，可選取「使用範例匯率」。範例匯率為虛構資料。"
          }
        }
      }
    },
