    "error.storage.message" : {
      "comment" : "Error alert message when on-device storage cannot be opened and the app runs without saving.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wechselkurse können auf diesem Gerät nicht gespeichert werden. Die App funktioniert normal, aber Daten gehen nach dem Schließen verloren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
