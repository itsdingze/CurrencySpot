          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous êtes hors ligne et aucun taux n’est encore enregistré. Connectez-vous à Internet pour obtenir les derniers taux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフラインで、保存済みのレートもまだありません。インターネットに接続して最新のレートを取得してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인터넷에 연결되어 있지 않고, 저장된 환율도 없어요. 인터넷에 연결해 최신 환율을 받아 주세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未连接网络，也没有已保存的汇率。请连接网络，获取最新汇率。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未連上網路，也沒有已儲存的匯率。請連上網路，取得最新匯率。"
          }
        }
      }
    },
