    "calculator.error.message.offline" : {
      "comment" : "Converter screen error message when the device is offline and no rates are saved, above the Use Sample Rates button.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du bist offline und es sind noch keine Kurse gespeichert. Stelle eine Internetverbindung her, um die aktuellen Kurse zu laden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You're offline and there are no saved rates yet. Connect to the internet to get the latest rates."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes conexión y aún no hay tipos guardados. Conéctate a internet para obtener los tipos más recientes."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
