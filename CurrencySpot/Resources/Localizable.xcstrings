    "history.volatilityInfo.footnote" : {
      "comment" : "Volatility explanation popover: closing note under the level list.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine niedrigere Volatilität bedeutet stabilere Wechselkurse, eine höhere Volatilität größere Kursschwankungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lower volatility means more stable exchange rates, while higher volatility indicates larger price swings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la volatilidad es baja, el tipo de cambio varía poco. Si es alta, varía más."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si la volatilidad es baja, la tasa de cambio varía poco. Si es alta, varía más."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une volatilité faible signifie des taux de change plus stables, tandis qu’une volatilité élevée indique de plus fortes variations."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ボラティリティが低いほど為替レートは安定しており、高いほど値動きが大きくなります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "변동성이 낮으면 환율 변화가 작고, 높으면 크게 오르내려요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "波动率越低，汇率越稳定。波动率越高，汇率波动越大。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "波動率越低，匯率越穩定。波動率越高，匯率波動越大。"
          }
        }
      }
    },
