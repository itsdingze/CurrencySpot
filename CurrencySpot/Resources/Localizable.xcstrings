    "settings.refreshAll.alert.message" : {
      "comment" : "Message of the alert confirming Refresh All Data in Settings.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden alle lokal gespeicherten Wechselkurse und historischen Daten gelöscht und anschließend neu aus dem Netzwerk geladen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This will erase all locally stored exchange rates and historical data, then download fresh data from the network."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borrarán todos los tipos de cambio y datos históricos guardados en el dispositivo y se descargarán datos nuevos de la red."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se borrarán todas las tasas de cambio y los datos históricos guardados en el dispositivo y se descargarán datos nuevos de la red."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tous les taux de change et données historiques enregistrés localement seront effacés, puis des données à jour seront téléchargées depuis le réseau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスに保存されている為替レートと履歴データをすべて消去してから、ネットワークから新しいデータをダウンロードします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기기에 저장된 환율과 이전 환율 데이터를 모두 지우고, 인터넷에서 최신 데이터를 다시 받아요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将清除本地保存的所有汇率和历史数据，再联网下载最新数据。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將清除本機儲存的所有匯率和歷史資料，再連上網路下載最新資料。"
          }
        }
      }
    },
